{
  "name": "scrollparent-polyfill",
  "version": "1.0.1",
  "description": "A JavaScript polyfill for Element.scrollParent()",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/scrollparent-polyfill.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "prebuild": "npm run clean",
    "build": "npm run build:module && npm run build:iife",
    "build:module": "tsc",
    "build:iife": "esbuild src/index.ts --bundle --format=iife --outfile=dist/scrollparent-polyfill.iife.js",
    "type-check": "tsc --noEmit",
    "start": "serve",
    "test": "npm run test:unit && npm run test:wpt",
    "pretest:unit": "npm run build && playwright install --with-deps",
    "test:unit": "playwright test --config playwright.config.ts",
    "test:unit:serve": "serve -l tcp://127.0.0.1:7357",
    "test:wpt": "npm run build && npm run test:wpt:setup && cd tests/wpt/src && (python wpt run --headless -y --log-wptreport ../report/data.json --log-wptscreenshot=../report/screenshots.txt --log-html=../report/index.html --inject-script ../../../dist/scrollparent-polyfill.iife.js firefox css/cssom-view/scrollParent* || true) && cd ../../../ && npm run test:wpt:report",
    "test:wpt:local": "npm run build && npm run test:wpt:setup && cd tests/wpt/src && python wpt serve --inject-script ../../../dist/scrollparent-polyfill.iife.js",
    "test:wpt:setup": "node tests/wpt/scripts/checkout-wpt.mjs && mkdir -p tests/wpt/report",
    "test:wpt:report": "node tests/wpt/scripts/generate-expected.js",
    "prepare": "husky",
    "prepack": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramus/scrollparent-polyfill.git"
  },
  "keywords": [
    "getScrollParent",
    "getScrollparent",
    "polyfill",
    "scroll-parent",
    "containing-block"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "serve": "^14.2.6",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "get-containing-block": "^1.0.4"
  }
}
